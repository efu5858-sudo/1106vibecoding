{
  "manifest_version": 3,
  "name": "오늘 할 일 작성기",
  "version": "1.2.0",
  "description": "오늘 할 일을 추가하고 완료 여부를 관리합니다.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["popup.html", "popup.css", "popup.js", "weather.js", "icons/icon-16.png", "icons/icon-32.png"],
    "matches": ["http://*/*", "https://*/*"]
  }],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "오늘 할 일 작성기",
    "default_popup": "popup.html"
  }
}
